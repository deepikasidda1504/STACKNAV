{
    "manifest_version": 3,

    "name": "Browser History Stack Controller",

    "version": "1.0",

    "description": "Controls browser navigation using two stacks.",

    "permissions": [
        "tabs",
        "webNavigation"
    ],

    "host_permissions": [
        "<all_urls>"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}